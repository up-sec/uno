# Todas estas variables son PÚBLICAS: llevan el prefijo NEXT_PUBLIC_ y terminan
# dentro del JavaScript que descarga el navegador. Aquí NUNCA van llaves
# secretas, semillas ni el secreto del HMAC.
# Copia este archivo como .env.local (que no se versiona).

# Red de Stellar a la que se conecta la dApp.
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Contrato Uno v1.1 desplegado en Testnet (ver README de la raíz).
NEXT_PUBLIC_UNO_CONTRACT_ID=CCPJ3LQOWC3NAJYV77FO74HKELG7YXJ4ANMSALXKHGIKAJJ6FXFQDMQQ

# Token MXNDEMO (contrato SAC del activo clásico MXNDEMO, emitido por emisor-mxn).
NEXT_PUBLIC_MXNDEMO_TOKEN_ID=CAKQXZLMZBOR5EJNHVJBB7UHYXAHX2JHPES3N7HSMBQUNOJZEKPDW2HZ

# Dirección PÚBLICA (G...) del verificador que se propone por defecto al crear
# un programa. Es la cuenta "verificador" de la CLI: stellar keys address verificador
NEXT_PUBLIC_DEFAULT_VERIFIER=GALQCEPGWOUP2TYTAMHRLZA2YT4JQLO6OXOHKWETBKFTOUMEOX4JGSBL

# Las variables de esta PRIMERA sección son PÚBLICAS: llevan el prefijo NEXT_PUBLIC_ y terminan
# dentro del JavaScript que descarga el navegador. Aquí NUNCA van llaves
# secretas, semillas ni el secreto del HMAC.
# Copia este archivo como .env.local (que no se versiona).

# Red de Stellar a la que se conecta la dApp.
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Contrato Uno v1.1 desplegado en Testnet (ver README de la raíz).
NEXT_PUBLIC_UNO_CONTRACT_ID=CCPJ3LQOWC3NAJYV77FO74HKELG7YXJ4ANMSALXKHGIKAJJ6FXFQDMQQ

# Token MXNDEMO (contrato SAC del activo clásico MXNDEMO, emitido por emisor-mxn).
NEXT_PUBLIC_MXNDEMO_TOKEN_ID=CAKQXZLMZBOR5EJNHVJBB7UHYXAHX2JHPES3N7HSMBQUNOJZEKPDW2HZ

# Dirección PÚBLICA (G...) del verificador que se propone por defecto al crear
# un programa. Es la cuenta "verificador2" de la CLI: stellar keys address verificador2
NEXT_PUBLIC_DEFAULT_VERIFIER=GDBFXWWI72RKG6NE73MJDFQAVQPGXTS2ASDWDEF24EKTSGS3L2FRM674

# ─────────────────────────────────────────────────────────────────────────────
# Variables de SERVIDOR (secretas). NUNCA con prefijo NEXT_PUBLIC_, nunca en el
# repo ni en logs. Solo las leen src/server/* (protegidos con "server-only").
# Se validan al arrancar el servidor: si falta una o es inválida, no arranca.
# ─────────────────────────────────────────────────────────────────────────────

# Secreto del HMAC de la CURP (mínimo 32 caracteres). Genera uno con:
#   openssl rand -hex 32
# Si cambia, todas las huellas cambian: las personas ya registradas no coinciden.
UNO_HMAC_SECRET=

# Llave secreta (S…) de la cuenta verificadora (Punto Uno). Firma `issue`.
VERIFIER_SECRET=

# Llave secreta (S…) del relayer: paga comisiones, patrocina cuentas y envía `claim`.
RELAYER_SECRET=

# PIN del operador de Punto Uno (mínimo 16 caracteres).
PUNTO_UNO_PIN=

# Programas en los que el relayer acepta cobrar (lista separada por comas).
ALLOWED_PROGRAMS=0

# Tope global de cuentas que el relayer patrocina (cada una aparta ~1.5 XLM).
MAX_SPONSORED=25

# Tope de credenciales que emite este servidor (en memoria: no es confiable con
# varias instancias, ver docs/backend.md). /api/registro además limita 5
# peticiones por minuto por IP.
MAX_REGISTROS=20
